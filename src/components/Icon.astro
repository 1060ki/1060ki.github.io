---
interface Props {
  name: 'github' | 'x' | 'wantedly' | 'youtrust' | 'mail' | 'arrow';
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['h-full w-full', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="none"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'github' && (
      <path
        fill="currentColor"
        d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
      />
    )
  }
  {
    name === 'x' && (
      <path
        fill="currentColor"
        d="M17.53 3h3.02l-6.6 7.54L21.75 21h-6.09l-4.77-6.23L5.43 21H2.4l7.06-8.07L2.25 3h6.24l4.31 5.7L17.53 3Zm-1.06 16.17h1.67L7.6 4.73H5.81l10.66 14.44Z"
      />
    )
  }
  {
    name === 'wantedly' && (
      <path
        fill="currentColor"
        d="M2 4.4h4.28l3.6 9.35 1.68-4.4L9.9 4.4h4.24l4.02 10.5L21.9 4.4H26l-6.3 15.2h-3.36l-2.5-6.4-2.46 6.4H8.02L2 4.4Z"
        transform="scale(0.86) translate(1.6 0.9)"
      />
    )
  }
  {
    name === 'youtrust' && (
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 4.8 12 12.4l8-7.6" />
        <path d="M12 12.4V20" />
      </g>
    )
  }
  {
    name === 'mail' && (
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2.5" y="5" width="19" height="14" rx="1.5" />
        <path d="m3 6.5 9 6.5 9-6.5" />
      </g>
    )
  }
  {
    name === 'arrow' && (
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17 17 7M9 7h8v8" />
      </g>
    )
  }
</svg>
