---
/**
 * 角トンボ / センタートンボ。
 * ビューポートを校正刷りの版面のように囲う、装飾専用のレイヤー。
 */
---

<!-- ヘッダーより手前に置く。トンボは版面の一部なので、追従ヘッダーに隠されない。 -->
<div class="pointer-events-none fixed inset-0 z-50 select-none no-print" aria-hidden="true">
  <!-- 角トンボ 4 隅。外側が塗り足し、内側が仕上がり線。 -->
  {
    (
      [
        ['top-2 left-2 sm:top-3 sm:left-3', ''],
        ['top-2 right-2 sm:top-3 sm:right-3', '-scale-x-100'],
        ['bottom-2 left-2 sm:bottom-3 sm:left-3', '-scale-y-100'],
        ['bottom-2 right-2 sm:bottom-3 sm:right-3', '-scale-100'],
      ] as const
    ).map(([pos, flip]) => (
      <svg
        class:list={['absolute h-7 w-7 sm:h-10 sm:w-10 text-mark/45', pos, flip]}
        viewBox="0 0 40 40"
        fill="none"
        stroke="currentColor"
        stroke-width="0.9"
        vector-effect="non-scaling-stroke"
      >
        <path d="M0 24 H24 M0 30 H24 M24 0 V24 M30 0 V24" />
      </svg>
    ))
  }

  <!-- センタートンボ。上下左右の中央に。 -->
  <svg
    class="absolute top-2 left-1/2 h-5 w-10 -translate-x-1/2 text-mark/35 sm:top-3"
    viewBox="0 0 40 20"
    fill="none"
    stroke="currentColor"
    stroke-width="0.9"
  >
    <path d="M20 0 V20 M8 12 H32" />
    <circle cx="20" cy="12" r="5.5" />
  </svg>
  <svg
    class="absolute bottom-2 left-1/2 h-5 w-10 -translate-x-1/2 rotate-180 text-mark/35 sm:bottom-3"
    viewBox="0 0 40 20"
    fill="none"
    stroke="currentColor"
    stroke-width="0.9"
  >
    <path d="M20 0 V20 M8 12 H32" />
    <circle cx="20" cy="12" r="5.5" />
  </svg>
  <svg
    class="absolute top-1/2 left-2 h-10 w-5 -translate-y-1/2 -rotate-90 text-mark/35 sm:left-3"
    viewBox="0 0 20 40"
    fill="none"
    stroke="currentColor"
    stroke-width="0.9"
  >
    <path d="M0 20 H20 M12 8 V32" />
    <circle cx="12" cy="20" r="5.5" />
  </svg>
  <svg
    class="absolute top-1/2 right-2 h-10 w-5 -translate-y-1/2 rotate-90 text-mark/35 sm:right-3"
    viewBox="0 0 20 40"
    fill="none"
    stroke="currentColor"
    stroke-width="0.9"
  >
    <path d="M0 20 H20 M12 8 V32" />
    <circle cx="12" cy="20" r="5.5" />
  </svg>
</div>
