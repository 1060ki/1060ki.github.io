---
import ColorBar from './ColorBar.astro';
import { profile } from '../data/profile';
---

<section
  class="relative flex min-h-[100svh] flex-col justify-center overflow-hidden"
  aria-label="Introduction"
>
  <!-- 製図のガイド線。読み込み時に一度だけ引かれる。
       狭い画面では名前と交差し、縦罫線がセンタートンボにも重なるので、
       余白がじゅうぶん取れる md 以上でだけ引く。 -->
  <div class="pointer-events-none absolute inset-0 z-0 hidden no-print md:block" aria-hidden="true">
    {
      /* 横罫線は上下で同じ値にすること。画面の 50%（＝センタートンボの位置）が
         罫線の中点になる、という関係で成り立っている。 */
    }
    <div
      class="anim-guide-x absolute top-[32%] left-0 h-px w-full bg-rule"
      style="animation-delay:.1s"
    >
    </div>
    <div
      class="anim-guide-x absolute bottom-[32%] left-0 h-px w-full bg-rule"
      style="animation-delay:.28s"
    >
    </div>

    {
      /* 縦罫線は本文カラムに乗せる。max-w / padding を本文側と揃えてあるので、
         内側の div の幅がそのまま文字列の幅になり、そこから -7 だけ外に出す。
         カラムが中央寄せなので、左右対称もこれで自動的に保たれる。 */
    }
    <div class="absolute inset-x-0 inset-y-0 mx-auto w-full max-w-5xl gutter-x">
      <div class="relative h-full">
        <div
          class="anim-guide-y absolute inset-y-0 -left-7 w-px bg-rule"
          style="animation-delay:.2s"
        >
        </div>
        <div
          class="anim-guide-y absolute inset-y-0 -right-7 w-px bg-rule"
          style="animation-delay:.38s"
        >
        </div>
      </div>
    </div>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-5xl gutter-x">
    <p
      class="anim-fade-up mb-6 font-mono text-[0.68rem] tracking-[0.3em] text-ink-faint uppercase sm:text-xs"
      style="animation-delay:.35s"
    >
      {profile.location} &nbsp;/&nbsp; {profile.handle}
    </p>

    <h1
      class="anim-ink-in font-display text-[clamp(3rem,14vw,8.5rem)] leading-[1.05] font-light tracking-[-0.015em]"
    >
      {profile.displayName}
    </h1>

    <div
      class="anim-fade-up mt-8 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6"
      style="animation-delay:.75s"
    >
      <ColorBar class="shrink-0" />
      <p class="text-ja min-w-0 text-sm text-ink-muted sm:text-base">
        {profile.nameJa}
        <span class="mt-1 block text-ink-faint sm:mt-0 sm:ml-2 sm:inline">
          — {profile.role}
        </span>
      </p>
    </div>

    <p
      class="anim-fade-up text-ja mt-10 max-w-xl text-base leading-relaxed text-ink-muted sm:text-lg"
      style="animation-delay:.95s"
    >
      {
        /* 節ごとに inline-block にして、折り返しをこの区切りだけに限定する */
        profile.tagline.map((clause) => <span class="inline-block">{clause}</span>)
      }
    </p>
  </div>

  <a
    href="#about"
    class="anim-fade-up no-print absolute bottom-12 left-1/2 z-10 hidden -translate-x-1/2 flex-col items-center gap-3 font-mono text-[0.62rem] tracking-[0.28em] text-ink-faint uppercase transition-colors hover:text-accent [@media(min-height:680px)]:flex"
    style="animation-delay:1.2s"
  >
    Scroll
    <span class="h-10 w-px bg-current opacity-50" aria-hidden="true"></span>
  </a>
</section>
